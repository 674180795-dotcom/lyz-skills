{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/resume-studio/candidate-ledger.schema.json",
  "title": "Resume Studio Candidate Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "target", "basics", "evidence_items", "skills", "uncertainties", "confirmation"],
  "properties": {
    "version": {"const": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "jd_available"],
      "properties": {
        "role": {"type": "string"},
        "company": {"type": "string"},
        "market": {"type": "string"},
        "language": {"enum": ["zh-CN", "en"]},
        "jd_available": {"type": "boolean"}
      }
    },
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": {"type": "string"},
        "email": {"type": "string"},
        "phone": {"type": "string"},
        "location": {"type": "string"},
        "links": {"type": "array", "items": {"type": "string"}}
      }
    },
    "education": {"type": "array", "items": {"type": "object"}},
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "ownership", "actions", "result", "proof", "status", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["work", "project", "education", "research", "competition", "volunteer", "other"]},
          "name": {"type": "string"},
          "organization": {"type": "string"},
          "role": {"type": "string"},
          "start": {"type": "string"},
          "end": {"type": "string"},
          "context": {"type": "string"},
          "ownership": {"type": "string"},
          "actions": {"type": "array", "items": {"type": "string"}},
          "methods": {"type": "array", "items": {"type": "string"}},
          "result": {"type": "string"},
          "proof": {"type": "string"},
          "evidence_type": {"enum": ["source_resume", "user_confirmed", "repository_verified", "document_verified", "conservative_estimate"]},
          "skills": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["draft", "confirmed"]},
          "confidence": {"enum": ["low", "medium", "high"]},
          "uncertainties": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "evidence_ids", "status"],
        "properties": {
          "name": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["draft", "confirmed"]}
        }
      }
    },
    "job_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "priority", "status", "evidence_ids"],
        "properties": {
          "requirement": {"type": "string"},
          "priority": {"enum": ["must", "preferred", "responsibility"]},
          "status": {"enum": ["supported", "partial", "gap", "unknown"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "issue", "blocking", "resolved"],
        "properties": {
          "field": {"type": "string"},
          "issue": {"type": "string"},
          "question": {"type": "string"},
          "blocking": {"type": "boolean"},
          "resolved": {"type": "boolean"}
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "confirmed"]},
        "confirmed_at": {"type": "string"}
      }
    }
  }
}
