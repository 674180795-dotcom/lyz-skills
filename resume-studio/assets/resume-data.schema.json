{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/resume-studio/resume-data.schema.json",
  "title": "Resume Studio Public Resume Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "language", "theme", "filename", "target", "basics", "education", "experience", "projects", "skills", "awards"],
  "properties": {
    "version": {"const": 1},
    "language": {"enum": ["zh-CN", "en"]},
    "theme": {"enum": ["ats-classic", "kami", "swiss", "tech", "campus", "compact"]},
    "section_order": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["education", "experience", "projects", "skills", "awards"]}
    },
    "filename": {"type": "string"},
    "target": {
      "type": "object",
      "required": ["role"],
      "properties": {"role": {"type": "string"}, "company_type": {"type": "string"}}
    },
    "basics": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": {"type": "string"},
        "headline": {"type": "string"},
        "phone": {"type": "string"},
        "email": {"type": "string"},
        "location": {"type": "string"},
        "summary": {"type": "string"},
        "links": {
          "type": "array",
          "items": {"type": "object", "required": ["label", "url"], "properties": {"label": {"type": "string"}, "url": {"type": "string"}}}
        },
        "photo": {
          "type": "object",
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}, "source": {"type": ["string", "null"]}, "alt": {"type": "string"}}
        }
      }
    },
    "education": {"type": "array", "items": {"type": "object"}},
    "experience": {"$ref": "#/$defs/entries"},
    "projects": {"$ref": "#/$defs/entries"},
    "skills": {
      "type": "array",
      "items": {"type": "object", "required": ["category", "items"], "properties": {"category": {"type": "string"}, "items": {"type": "array", "items": {"type": "string"}}}}
    },
    "awards": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["organization", "role", "bullets"],
        "properties": {
          "organization": {"type": "string"},
          "role": {"type": "string"},
          "start": {"type": "string"},
          "end": {"type": "string"},
          "location": {"type": "string"},
          "tech": {"type": "array", "items": {"type": "string"}},
          "link": {"type": "string"},
          "bullets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["text", "evidence_type", "source_note"],
              "properties": {
                "text": {"type": "string"},
                "evidence_type": {"enum": ["source_resume", "user_confirmed", "repository_verified", "document_verified", "conservative_estimate"]},
                "source_note": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
