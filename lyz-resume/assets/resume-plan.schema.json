{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/lyz-resume/resume-plan.schema.json",
  "title": "Resume Studio Targeted Composition Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "content_mode",
    "role_thesis",
    "priority_requirement_ids",
    "evidence_decisions",
    "section_order",
    "section_budget",
    "first_page_story",
    "confirmation"
  ],
  "properties": {
    "version": {"const": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "company": {"type": "string"}
      }
    },
    "content_mode": {"enum": ["targeted", "layout-only"]},
    "role_thesis": {"type": "string", "minLength": 1},
    "priority_requirement_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "evidence_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "requirement_ids", "tier", "placement", "bullet_budget", "reason"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "tier": {"enum": ["core", "supporting", "brief", "omit"]},
          "placement": {"type": "string"},
          "bullet_budget": {"type": "integer", "minimum": 0, "maximum": 5},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "section_order": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["education", "experience", "projects", "skills", "awards"]}
    },
    "section_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "education": {"type": "integer", "minimum": 0, "maximum": 10},
        "experience": {"type": "integer", "minimum": 0, "maximum": 20},
        "projects": {"type": "integer", "minimum": 0, "maximum": 20},
        "skills": {"type": "integer", "minimum": 0, "maximum": 10},
        "awards": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "first_page_story": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"type": "string"}
    },
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "confirmed"]},
        "confirmed_at": {"type": "string"}
      }
    }
  }
}
